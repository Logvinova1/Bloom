@model ContactViewModel
@{
    ViewData["Title"] = L["Nav_Contact"].Value;
}
<section class="container section" style="padding-top:2.5rem;">
    <h2>@L["Contact_Title"]</h2>
    <p style="color:var(--muted);margin-bottom:1.5rem;max-width:40ch;">@L["Contact_Intro"]</p>
    @if (TempData["Success"] != null)
    {
        <div class="alert-ok">✓ Message sent</div>
    }
    <div class="panel">
        <form asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert-err"></div>
            <div class="form-group">
                <label asp-for="Name">@L["Contact_Name"]</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="alert-err"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email">@L["Contact_Email"]</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="alert-err"></span>
            </div>
            <div class="form-group">
                <label asp-for="Message">@L["Contact_Message"]</label>
                <textarea asp-for="Message" class="form-control"></textarea>
                <span asp-validation-for="Message" class="alert-err"></span>
            </div>
            <button type="submit" class="btn btn-primary">@L["Contact_Send"]</button>
        </form>
    </div>
</section>
