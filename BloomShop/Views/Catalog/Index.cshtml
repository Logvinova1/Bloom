@model List<Product>
@{
    ViewData["Title"] = L["Nav_Catalog"].Value;
    var uk = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "uk";
}
<section class="container section" style="padding-top:2.5rem;">
    <h2>@L["Section_All"]</h2>
    <div class="grid">
        @foreach (var p in Model)
        {
            <article class="card">
                <div class="card-media">@p.Emoji</div>
                <div class="card-body">
                    <div class="card-cat">@p.Category · @p.Color</div>
                    <h3 class="card-title">@(uk ? p.NameUk : p.NameEn)</h3>
                    <div class="card-price">@p.Price.ToString("0") ₴</div>
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-ghost" style="margin-top:.75rem;padding:8px 14px;font-size:.85rem;">@L["Btn_Details"]</a>
                </div>
            </article>
        }
    </div>
</section>
